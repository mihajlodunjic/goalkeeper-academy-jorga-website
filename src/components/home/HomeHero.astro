---
import { Picture } from "astro:assets";
import ButtonLink from "../ui/ButtonLink.astro";
import PenaltyAreaLines from "../brand/PenaltyAreaLines.astro";
import FocusMarker from "../brand/FocusMarker.astro";
import heroImage from "../../assets/images/home/hero-goalkeeper.jpg";
import heroMobileImage from "../../assets/images/home/hero-goalkeeper-mobile.jpg";
import { business } from "../../data/business";
---

<section class="home-hero section section--dark">
  <div class="container-wide home-hero__grid">
    <div class="home-hero__copy flow reveal">
      <p class="eyebrow">Beograd · Specijalizovani golmanski rad</p>
      <h1>Golman se ne priprema kao ostatak tima.</h1>
      <p class="lead dark-muted">
        Individualni i grupni treninzi, škola golmana, fizička priprema i kampovi za različite
        uzraste i nivoe iskustva — sa radom usmerenim na tehniku, odluku, pozicioniranje i igru
        nogom.
      </p>
      <div class="cluster home-hero__actions">
        <ButtonLink href="/programi">Izaberi program</ButtonLink>
        <ButtonLink href={business.phones[0].href} variant="secondary">
          Pozovi za aktuelni termin
        </ButtonLink>
      </div>
      <ul class="home-hero__tags" aria-label="Fokus rada">
        <li>Tehnika</li>
        <li class="is-active">Odluka</li>
        <li>Pozicija</li>
        <li>Igra nogom</li>
      </ul>
    </div>

    <div class="home-hero__visual reveal">
      <PenaltyAreaLines className="home-hero__lines" />
      <div class="home-hero__frame">
        <div class="desktop-only media-frame media-frame--hero" style="--media-position: 50% 42%;">
          <Picture
            src={heroImage}
            alt="Golman u odbrani tokom treninga na fudbalskom terenu"
            widths={[560, 760, 960, 1280, 1600]}
            sizes="(min-width: 1040px) 52vw, 100vw"
            formats={["avif", "webp"]}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="media-cover"
          />
        </div>
        <div class="mobile-only media-frame media-frame--hero-mobile" style="--media-position: 56% 34%;">
          <Picture
            src={heroMobileImage}
            alt="Golman u odbrani tokom treninga na fudbalskom terenu"
            widths={[420, 560, 760, 900]}
            sizes="100vw"
            formats={["avif", "webp"]}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="media-cover"
          />
        </div>
        <FocusMarker className="home-hero__marker" label="Odluka" note="Zona reakcije" />
      </div>
    </div>
  </div>

  <div class="home-hero__meta">
    <div class="container-wide">
      <ul>
        <li>Individualni rad</li>
        <li>Grupni rad</li>
        <li>Kampovi</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: 0;
    overflow: clip;
  }

  .home-hero__grid {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    min-width: 0;
    min-height: 0;
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
  }

  .home-hero__actions {
    margin-top: 1.4rem;
  }

  .home-hero__tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.6rem;
    list-style: none;
  }

  .home-hero__tags li {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.9rem;
    border: 1px solid rgba(143, 200, 232, 0.22);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero__tags li.is-active {
    border-color: var(--color-blue-500);
    background: rgba(41, 121, 178, 0.22);
    color: var(--color-white);
  }

  .home-hero__visual {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .home-hero__frame {
    position: relative;
    min-height: 0;
    border-left: 1px solid rgba(143, 200, 232, 0.22);
    padding-left: clamp(1rem, 2.6vw, 2rem);
  }

  .home-hero__marker {
    right: 1rem;
    bottom: 1.2rem;
  }

  .home-hero__meta {
    margin-top: 2rem;
    border-top: 1px solid rgba(143, 200, 232, 0.18);
    border-bottom: 1px solid rgba(143, 200, 232, 0.18);
    background: rgba(4, 13, 22, 0.7);
  }

  .home-hero__meta ul {
    display: grid;
    gap: 0;
    list-style: none;
  }

  .home-hero__meta li {
    padding: 0.95rem 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-blue-300);
    border-bottom: 1px solid rgba(143, 200, 232, 0.14);
  }

  .home-hero__meta li:last-child {
    border-bottom: none;
  }

  @media (min-width: 1040px) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      min-height: clamp(42.5rem, calc(100svh - var(--header-height) - 1rem), 52rem);
    }

    .home-hero__copy {
      padding-right: 3rem;
    }

    .home-hero__meta ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .home-hero__meta li {
      border-bottom: none;
    }
  }

  @media (max-width: 1039px) {
    .home-hero__frame {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
