---
import BrandLogo from "../brand/BrandLogo.astro";
import { business } from "../../data/business";
import { navigation } from "../../data/navigation";
import { requiresPublicPhotoCredits } from "../../data/photoCredits";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__line" aria-hidden="true"></div>
  <div class="container-wide site-footer__grid">
    <div class="site-footer__brand flow">
      <BrandLogo alt="Golmanska akademija Jorgačević" />
      <p>{business.summary}</p>
    </div>

    <nav aria-label="Navigacija u podnožju" class="site-footer__nav">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <address class="site-footer__contact">
      <p>Direktan kontakt</p>
      <a href={business.phones[0].href}>{business.phones[0].display}</a>
      <a href={business.phones[1].href}>{business.phones[1].display}</a>
      <a href={business.instagram.url} target="_blank" rel="noreferrer">{business.instagram.handle}</a>
      <span>{business.areaServed}</span>
    </address>
  </div>

  <div class="container-wide site-footer__bottom">
    <p>© {year} Golmanska akademija Jorgačević. Sva prava zadržana.</p>
    {requiresPublicPhotoCredits ? <a href="/fotografije-i-licence">Fotografije i licence</a> : null}
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 3.5rem 0 1.25rem;
    color: var(--color-white);
    background: var(--color-ink-950);
    overflow: clip;
  }

  .site-footer__line {
    position: absolute;
    inset: 1.4rem 0 auto;
    width: min(88vw, 74rem);
    height: 9rem;
    border-top: 2px solid rgba(255, 255, 255, 0.92);
    border-right: 2px solid rgba(255, 255, 255, 0.92);
    border-top-right-radius: 7rem;
  }

  .site-footer__grid {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-top: 2.7rem;
  }

  .site-footer__brand p,
  .site-footer__bottom,
  .site-footer__contact span {
    color: rgba(255, 255, 255, 0.78);
  }

  .site-footer__nav ul,
  .site-footer__contact {
    display: grid;
    gap: 0.65rem;
    list-style: none;
  }

  .site-footer__nav a,
  .site-footer__contact a,
  .site-footer__bottom a {
    color: var(--color-white);
    text-decoration: none;
  }

  .site-footer__contact {
    font-style: normal;
  }

  .site-footer__contact p {
    margin: 0 0 0.2rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-blue-300);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.7rem;
    padding-top: 1.6rem;
    margin-top: 2rem;
    border-top: 1px solid rgba(143, 200, 232, 0.18);
    font-size: 0.9rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1.15fr 0.7fr 0.85fr;
      align-items: start;
    }
  }
</style>
