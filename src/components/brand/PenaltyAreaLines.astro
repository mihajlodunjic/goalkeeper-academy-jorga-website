---
type Props = {
  className?: string;
};

const { className = "" } = Astro.props;
---

<svg
  class:list={["penalty-lines", className]}
  viewBox="0 0 720 520"
  aria-hidden="true"
  focusable="false"
>
  <path d="M30 60V500H330" />
  <path d="M30 150H220" />
  <path d="M30 310H220" />
  <path d="M220 150V310" />
  <path d="M330 60V500" />
  <path d="M330 220H520" />
  <path d="M520 220V340" />
  <path d="M520 340H690" />
</svg>

<style>
  .penalty-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .penalty-lines path {
    fill: none;
    stroke: rgba(143, 200, 232, 0.42);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
  }
</style>
